# ZenOTA Frontend Environment Configuration

# Public API URL (accessible by client/browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Internal API URL (for server-side rendering / docker internal network)
INTERNAL_API_URL=http://localhost:3001

# Mode (set to 'true' for self-hosted instances)
NEXT_PUBLIC_SELF_HOSTED=true

# NextAuth / Auth.js Configuration
AUTH_SECRET=change_me_super_secret_auth_key_at_least_32_chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional: Google OAuth (for Cloud / SaaS mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
