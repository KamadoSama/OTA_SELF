# ZenOTA Root Docker Compose Environment Configuration

# Ports
BACKEND_PORT=4001
FRONTEND_PORT=3000
EDGE_PORT=4005

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/ota_db?schema=public
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PUBLIC_URL=http://localhost:9000
JWT_SECRET=change_me_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4001
INTERNAL_API_URL=http://backend:4001
NEXT_PUBLIC_SELF_HOSTED=true
AUTH_SECRET=change_me_super_secret_auth_key
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional Analytics & OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
