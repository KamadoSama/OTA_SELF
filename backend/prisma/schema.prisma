generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model App {
  id         String   @id @default(uuid())
  name       String   @unique
  customerId String
  createdAt  DateTime @default(now())

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channels   Channel[]
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  appId     String
  createdAt DateTime @default(now())

  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  updates   Update[]

  @@unique([appId, name])
}

model Update {
  id             String   @id @default(uuid())
  channelId      String
  runtimeVersion String   // e.g "exposdk:50.0.0" or "1.0.0"
  platform       String   // "ios" | "android"
  createdAt      DateTime @default(now())
  metadata       Json?    // Optional extra metadata

  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assets         Asset[]

  @@index([channelId, runtimeVersion, platform])
}

model Asset {
  id        String   @id @default(uuid())
  updateId  String
  hash      String   // SHA-256 hash or Expo asset hash
  key       String   // MinIO object key (e.g., bundles/hash.js or assets/hash.png)
  contentType String
  fileExtension String?
  
  // Expo requires knowing if it's the main bundle or an external asset
  isLaunchAsset Boolean @default(false)

  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
}

enum SubscriptionTier {
  FREE
  PRO
}

model Customer {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt        DateTime         @default(now())

  apps             App[]
  apiKeys          ApiKey[]
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique // Hashed key stored here
  prefix     String    // First 8 chars visible to the user
  customerId String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
