# ZenOTA Backend Environment Configuration

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
SELF_HOSTED=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ota_db?schema=public

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PUBLIC_URL=http://localhost:9000

# Authentication & Security
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
OTA_ASSET_HMAC_SECRET=change_me_hmac_secret_key
